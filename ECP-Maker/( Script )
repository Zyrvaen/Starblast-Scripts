    for (const name of new Set(Object.values(OFFICIAL_BUILD))) game.build[name] = p[name];
    for (const name of Object.keys(game.build)) {
      p[name] = function () {
        const finish = String(this.finish || '');
        if (finish.startsWith('sbx-')) return shipMaterial(this, finish.slice(4));
        if (!game.preview && isMyShip(this)) return shipMaterial(this, state.material);
        return game.build[name].apply(this, arguments);
      };
    }
    for (const fn of ['exportThumbnail', 'exportHorizontalThumbnail']) {
      const original = Ship[fn];
      Ship[fn] = function () {
        game.preview++;
        try { return original.apply(this, arguments); } finally { game.preview--; }
      };
    }
    const getThumbnail = p.getThumbnail;
    p.getThumbnail = function () {
      if (game.naming != null && this.data && this.data.name) game.names[game.naming] = this.data.name;
