    police: (m, t) => motionGlow(m, mixHex(0xFF2020, 0x2050FF, 0.5 + 0.5 * Math.sin(t * 5))),
    fire: (m, t) => motionGlow(m, hsvHex(0.05 + 0.03 * Math.sin(t * 1.7), 1, 0.8 + 0.2 * Math.sin(t * 3) * Math.sin(t * 1.3))),
    electric: (m, t) => motionGlow(m, mixHex(0x1A40B0, 0xC0E8FF, Math.max(0, Math.sin(t * 2.7)) ** 3)),
    storm: (m, t) => { const p = (t * 0.6) % 1; motionGlow(m, mixHex(0x101420, 0xE0E8FF, p < 0.12 ? Math.sin(p / 0.12 * Math.PI / 2) : Math.exp(-(p - 0.12) * 7))); },
