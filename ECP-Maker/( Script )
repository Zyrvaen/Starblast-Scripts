  `;

  let root, ui = {};

  function setLive(on) {
    state.live = on;
    save();
    syncLive();
    if (on && !game.official) toast('Open the Elite Commander window once first.');
    animate();
  }
  function syncLive() {
    for (const el of document.querySelectorAll('.sbx-live-switch')) el.classList.toggle('on', !!state.live);
  }

  function build() {
    const file = make('input', { type: 'file', accept: 'image/*', hidden: true });
    const textureFile = make('input', { type: 'file', accept: 'image/*', hidden: true });
    const big = make('canvas', { className: 'sbx-big', width: 320, height: 160 });
    const nameBadge = canvasOf(60, 30), crop = make('canvas', { className: 'sbx-crop' });
    const zoom = make('input', { type: 'range', min: 0, max: 1000, value: 300 });
    const caption = make('div', { className: 'sbx-caption' });
    const name = make('span');
    const toastEl = make('div', { className: 'sbx-toast' });
    const icons = make('div'), materials = make('div');
    const lasers = make('div', { className: 'sbx-grid' }), saved = make('div', { className: 'sbx-grid' });
    const button = (text, onclick, cls = '') => make('button', { type: 'button', className: 'sbx-btn ' + cls, textContent: text, onclick });
    const bar = (title, note) => make('div', { className: 'sbx-bar' }, [make('span', { textContent: title }), make('small', { textContent: note || '' })]);

    let shipBlock = [], ship = null, shipName = null, hue = null;
    if (game.Ship) {
      ship = make('canvas', { className: 'sbx-ship', width: 200, height: 200 });
      shipName = make('span');
      hue = make('input', { type: 'range', min: 0, max: 359, value: state.hue });
      const step = by => () => {
        const i = SHIPS.indexOf(state.ship);
        state.ship = SHIPS[(i + by + SHIPS.length) % SHIPS.length];
        changed();
      };
      hue.addEventListener('input', () => { state.hue = +hue.value; changed(true); });
      hue.addEventListener('change', () => { save(); refresh(); });
      shipBlock = [
        bar('Ship'),
        make('div', { className: 'sbx-stage' }, [
          ship,
          make('div', { className: 'sbx-shiprow' }, [
            make('i', { className: 'sbx-arrow', textContent: '◀', onclick: step(-1) }), shipName,
            make('i', { className: 'sbx-arrow', textContent: '▶', onclick: step(1) }),
          ]),
          make('div', { className: 'sbx-hue' }, [hue]),
        ]),
      ];
    }

    const live = make('div', { className: 'sbx-live', onclick: () => setLive(!state.live) }, [
      make('span', { className: 'sbx-switch sbx-live-switch' }),
      make('div', {}, [make('b', { textContent: 'Show in game' }), make('small', { textContent: 'only you see it' })]),
    ]);

    const left = make('div', { className: 'sbx-side' }, [
      bar('Preview'),
      make('div', { className: 'sbx-stage' }, [big, caption]),
      ...shipBlock,
      make('div', { className: 'sbx-name' }, [nameBadge, name]),
      live,
      make('div', { className: 'sbx-row', style: 'margin-top:12px' }, [
        button('Download', () => download(drawBadge(canvasOf(1, 1), 512), 'ecp-badge.png'), 'main'),
        button('Save', keepBadge, 'main'),
      ]),
    ]);

    const right = make('div', {}, [
      bar('Picture', 'drag · scroll to zoom'),
      make('div', { className: 'sbx-crop-wrap' }, [
        crop,
        make('div', { className: 'sbx-crop-tools' }, [
          button('Upload picture', () => file.click(), 'main'),
          make('div', { className: 'sbx-note', textContent: 'You can also drop or paste a picture.' }),
          make('label', { textContent: 'Zoom' }), zoom,
          make('div', { className: 'sbx-row' }, [
            button('↺', () => rotate(-90), 'small'),
            button('↻', () => rotate(90), 'small'),
            button('Fit', () => fit('fit'), 'small'),
            button('Fill', () => fit('fill'), 'small'),
          ]),
        ]),
      ]),
      bar('Icon'),
      icons,
      bar('Material', '★ in game · ▶ moves'),
      materials,
      bar('Laser'),
      lasers,
      bar('Saved'),
      saved,
    ]);

    root = make('div', { id: 'sbx-ecp' }, [
      make('div', { className: 'sbx-head' }, [make('span', { className: 'sbx-close', textContent: '×', onclick: close }), make('span', { textContent: 'ECP Maker' })]),
      make('div', { className: 'sbx-body' }, [left, right]),
      toastEl, file, textureFile,
    ]);
    document.body.append(root);

    ui = { big, nameBadge, crop, zoom, caption, name, toastEl, icons, materials, lasers, saved, ship, shipName, hue };

    const addTile = (label, onclick, round) => make('div', { className: 'sbx-pick sbx-add', title: label, onclick }, [
      make('div', { className: 'sbx-plus' + (round ? ' round' : ''), textContent: '+' }), make('div', { textContent: label }),
    ]);
    for (const [group, ids] of ICON_GROUPS) {
      const grid = make('div', { className: 'sbx-grid icons' });
      for (const id of ids) {
        if (id === 'custom') {
          grid.append(addTile('Upload picture', () => file.click(), true));
          ui.myPictures = grid;
          continue;
        }
        const c = canvasOf(34, 34);
        const pick = make('div', { className: 'sbx-pick', title: iconTitle(id) }, [c, make('div', { textContent: iconName(id) })]);
        pick.onclick = () => { state.icon = id; changed(); };
        pick.dataset.id = id; pick._canvas = c;
        grid.append(pick);
      }
      icons.append(make('div', { className: 'sbx-sub', textContent: group }), grid);
    }
    ui.animPicks = [];
    for (const [group] of MATERIAL_GROUPS) {
      const grid = make('div', { className: 'sbx-grid' });
      for (const m of MATERIALS.filter(x => x.group === group)) {
        if (m.id === 'texture') {
          grid.append(addTile('Upload texture', () => textureFile.click(), false));
          ui.myTextures = grid;
          continue;
        }
        const c = canvasOf(64, 32);
        const pick = make('div', { className: 'sbx-pick', title: m.name }, [c, make('div', { textContent: m.name })]);
        if (m.official) pick.append(make('span', { className: 'sbx-star', textContent: '★' }));
        if (m.anim) { pick.append(make('span', { className: 'sbx-anim', textContent: '▶' })); ui.animPicks.push(pick); }
        pick.onclick = () => { state.material = m.id; changed(); };
        pick.dataset.id = m.id; pick._canvas = c;
        grid.append(pick);
      }
      materials.append(make('div', { className: 'sbx-sub', textContent: group }), grid);
    }
    LASER_NAMES.forEach((label, i) => {
      const c = canvasOf(64, 32);
      const pick = make('div', { className: 'sbx-pick', title: label }, [c, make('div', { textContent: label })]);
      if (i < 4) pick.append(make('span', { className: 'sbx-star', textContent: '★' }));
      pick.onclick = () => { state.laser = i; changed(); };
      pick.dataset.id = String(i); pick._canvas = c;
      lasers.append(pick);
    });

    file.onchange = () => { if (file.files[0]) usePicture(file.files[0]); file.value = ''; };
    textureFile.onchange = () => { if (textureFile.files[0]) useTexture(textureFile.files[0]); textureFile.value = ''; };
    crop.addEventListener('dragover', e => { e.preventDefault(); crop.classList.add('drop'); });
    crop.addEventListener('dragleave', () => crop.classList.remove('drop'));
    crop.addEventListener('drop', e => {
      e.preventDefault(); crop.classList.remove('drop');
      const f = [...e.dataTransfer.files].find(x => x.type.startsWith('image/'));
      if (f) usePicture(f);
    });
    document.addEventListener('paste', e => {
      if (!root.classList.contains('open')) return;
      const item = [...(e.clipboardData?.items || [])].find(x => x.type.startsWith('image/'));
      if (item) { e.preventDefault(); usePicture(item.getAsFile()); }
    });

    bindCrop();
    syncLive();

    for (const type of ['keydown', 'keyup', 'keypress']) {
      root.addEventListener(type, e => { if (e.key === 'Escape' && type === 'keydown') close(); e.stopPropagation(); });
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && root.classList.contains('open')) close(); });
    root.addEventListener('wheel', e => e.stopPropagation(), { passive: true });
  }

  const CROP = 260, RING = 0.4 * CROP;

  const zoomOf = p => Math.min(assets.picture.naturalWidth, assets.picture.naturalHeight) / p.d;
  const zoomToSlider = z => Math.round(Math.log(z / 0.25) / Math.log(64) * 1000);
  const sliderToZoom = v => 0.25 * Math.pow(64, v / 1000);

  function drawCrop() {
    const c = ui.crop, dpr = Math.min(2, window.devicePixelRatio || 1);
    if (c.width !== CROP * dpr) { c.width = c.height = CROP * dpr; }
    const g = c.getContext('2d');
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    for (let y = 0; y < CROP; y += 13) for (let x = 0; x < CROP; x += 13) {
      g.fillStyle = (x + y) / 13 % 2 ? '#0e1b21' : '#132630'; g.fillRect(x, y, 13, 13);
    }
    const p = state.picture, img = assets.picture;
    if (!p || !img) {
      g.strokeStyle = 'rgba(204,238,255,.5)'; g.setLineDash([6, 6]); g.lineWidth = 2;
      g.beginPath(); g.arc(CROP / 2, CROP / 2, RING, 0, TAU); g.stroke(); g.setLineDash([]);
      g.fillStyle = 'rgba(204,238,255,.8)'; g.font = '15px Play, Verdana'; g.textAlign = 'center'; g.textBaseline = 'middle';
      g.fillText('Drop a picture here', CROP / 2, CROP / 2 - 10);
      g.font = '12px Play, Verdana'; g.fillStyle = 'rgba(204,238,255,.5)';
      g.fillText('or press Upload picture', CROP / 2, CROP / 2 + 12);
      return;
    }
    const k = 2 * RING / p.d;
    const place = () => { g.translate(CROP / 2, CROP / 2); g.scale(k, k); g.rotate(p.rot * RAD); g.drawImage(img, -p.cx, -p.cy); };
    g.save(); g.globalAlpha = 0.28; place(); g.restore();
    g.save(); g.beginPath(); g.arc(CROP / 2, CROP / 2, RING, 0, TAU); g.clip(); place(); g.restore();
    g.strokeStyle = 'rgba(0,0,0,.6)'; g.lineWidth = 4;
    g.beginPath(); g.arc(CROP / 2, CROP / 2, RING + 2, 0, TAU); g.stroke();
    g.strokeStyle = 'rgba(255,255,255,.95)'; g.lineWidth = 1.5;
    g.beginPath(); g.arc(CROP / 2, CROP / 2, RING, 0, TAU); g.stroke();
    g.strokeStyle = 'rgba(255,190,90,.6)'; g.setLineDash([4, 5]); g.lineWidth = 1;
    g.beginPath(); g.arc(CROP / 2, CROP / 2, RING * 0.6 / 0.45 - 4, 0, TAU); g.stroke(); g.setLineDash([]);
    g.strokeStyle = 'rgba(255,255,255,.35)'; g.lineWidth = 1;
    g.beginPath(); g.moveTo(CROP / 2 - 6, CROP / 2); g.lineTo(CROP / 2 + 6, CROP / 2); g.moveTo(CROP / 2, CROP / 2 - 6); g.lineTo(CROP / 2, CROP / 2 + 6); g.stroke();
  }

  function bindCrop() {
    const c = ui.crop;
    let drag = null;
    c.addEventListener('pointerdown', e => {
      if (!state.picture) return;
      drag = { x: e.clientX, y: e.clientY };
      c.setPointerCapture(e.pointerId); c.classList.add('dragging');
    });
    c.addEventListener('pointermove', e => {
      if (!drag) return;
      const p = state.picture, k = 2 * RING / p.d, a = p.rot * RAD;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      drag = { x: e.clientX, y: e.clientY };
      p.cx -= (dx * Math.cos(a) + dy * Math.sin(a)) / k;
      p.cy -= (-dx * Math.sin(a) + dy * Math.cos(a)) / k;
      changed(true);
    });
    const end = () => { if (drag) { drag = null; c.classList.remove('dragging'); save(); refresh(); } };
    c.addEventListener('pointerup', end);
    c.addEventListener('pointercancel', end);
    c.addEventListener('wheel', e => {
      if (!state.picture) return;
      e.preventDefault();
      setZoom(zoomOf(state.picture) * Math.pow(1.0015, -e.deltaY));
    }, { passive: false });
    c.addEventListener('dblclick', () => state.picture && fit('fill'));
    ui.zoom.addEventListener('input', () => state.picture && setZoom(sliderToZoom(+ui.zoom.value), true));
    ui.zoom.addEventListener('change', () => { save(); refresh(); });
  }

  function setZoom(z, fromSlider) {
    const img = assets.picture;
    z = Math.max(0.25, Math.min(16, z));
    state.picture.d = Math.min(img.naturalWidth, img.naturalHeight) / z;
    if (!fromSlider) ui.zoom.value = zoomToSlider(z);
    changed(fromSlider);
  }

  function rotate(by) {
    if (!state.picture) return toast('Upload a picture first.');
    state.picture.rot = ((state.picture.rot + by) % 360 + 360) % 360;
    changed();
  }

  function fit(how) {
    const p = state.picture, img = assets.picture;
    if (!p || !img) return toast('Upload a picture first.');
    const w = img.naturalWidth, h = img.naturalHeight;
    p.cx = w / 2; p.cy = h / 2;
    p.d = how === 'fit' ? Math.hypot(w, h) * 0.98 : Math.min(w, h);
    ui.zoom.value = zoomToSlider(zoomOf(p));
    changed();
  }

  async function shrink(blob, max) {
    const url = URL.createObjectURL(blob);
    try {
      const img = await new Promise((resolve, reject) => { const i = new Image(); i.onload = () => resolve(i); i.onerror = reject; i.src = url; });
      const s = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
      const c = canvasOf(Math.max(1, Math.round(img.naturalWidth * s)), Math.max(1, Math.round(img.naturalHeight * s)));
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      return toData(c);
    } finally { URL.revokeObjectURL(url); }
  }

  async function usePicture(blob) {
    try {
      const src = await shrink(blob, 900);
      const img = await loadImage(src);
      const crop = { cx: img.naturalWidth / 2, cy: img.naturalHeight / 2, d: Math.min(img.naturalWidth, img.naturalHeight), rot: 0 };
      const entry = keepUpload('pictures', { key: newKey(), src, crop });
      await pickPicture(entry);
    } catch (e) { toast('Not a picture.'); }
  }

  async function useTexture(blob) {
    try {
      const src = await shrink(blob, 512);
      const entry = keepUpload('textures', { key: newKey(), src });
      await pickTexture(entry);
    } catch (e) { toast('Not a picture.'); }
  }

  async function pickPicture(entry) {
    const img = await loadImage(entry.src);
    assets.picture = img;
    state.picture = { ...entry.crop, src: entry.src, key: entry.key };
    state.icon = 'custom';
    if (ui.zoom) ui.zoom.value = zoomToSlider(zoomOf(state.picture));
    changed();
  }

  async function pickTexture(entry) {
    state.texture = entry.src;
    assets.texture = await loadImage(entry.src);
    game.patterns.forEach((tex, key) => { if (key.startsWith('texture:') || key === 'env:texture') game.patterns.delete(key); });
    state.material = 'texture';
    changed();
  }

  function renderLibrary() {
    if (!ui.myPictures) return;
    for (const old of document.querySelectorAll('#sbx-ecp .sbx-upl')) old.remove();
    const tile = (kind, entry, i) => {
      const isPicture = kind === 'pictures';
      const c = isPicture ? canvasOf(68, 68) : canvasOf(64, 32);
      const pick = make('div', { className: 'sbx-pick sbx-upl', title: isPicture ? 'Your picture ' + (i + 1) : 'Your texture ' + (i + 1) }, [c, make('div', { textContent: isPicture ? 'Picture ' + (i + 1) : 'Texture ' + (i + 1) })]);
      const del = make('span', { className: 'sbx-del', textContent: '×', title: 'Remove from Yours' });
      del.onclick = e => {
        e.stopPropagation();
        library[kind] = library[kind].filter(x => x.key !== entry.key);
        storeLibrary(); renderLibrary();
      };
      pick.append(del);
      const selected = isPicture ? state.icon === 'custom' && state.picture && state.picture.key === entry.key
        : state.material === 'texture' && state.texture === entry.src;
      pick.classList.toggle('sel', !!selected);
      pick.onclick = () => (isPicture ? pickPicture(entry) : pickTexture(entry));
      loadImage(entry.src).then(img => {
        const g = c.getContext('2d');
        if (isPicture) {
          const p = entry.crop, s = 68;
          g.save(); g.beginPath(); g.arc(s / 2, s / 2, s / 2 - 1, 0, TAU); g.clip();
          g.translate(s / 2, s / 2); g.scale(s / p.d, s / p.d); g.rotate(p.rot * RAD); g.drawImage(img, -p.cx, -p.cy);
          g.restore();
        } else {
          const keep = assets.texture;
          assets.texture = img;
          drawBadge(c, 32, { icon: state.icon, material: 'texture', laser: state.laser });
          assets.texture = keep;
        }
      }).catch(() => {});
      return pick;
    };
    library.pictures.forEach((entry, i) => ui.myPictures.append(tile('pictures', entry, i)));
    library.textures.forEach((entry, i) => ui.myTextures.append(tile('textures', entry, i)));
  }

  function download(canvas, name) {
    canvas.toBlob(blob => {
      if (!blob) return toast('Download failed.');
      const url = URL.createObjectURL(blob);
      const a = make('a', { href: url, download: name });
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    }, 'image/png');
  }

  function keepBadge() {
    const list = read(SAVED, []);
    const cut = state.icon === 'custom' ? cutPicture(160) : null;
    if (state.icon === 'custom' && !cut) return toast('Upload a picture first.');
    const entry = { icon: state.icon, material: state.material, laser: state.laser, at: Date.now() };
    if (cut) entry.picture = toData(cut);
    if (state.material === 'texture' && state.texture) entry.texture = state.texture;
    list.unshift(entry);
    if (!write(SAVED, list.slice(0, MAX_SAVED))) return toast('Storage is full.');
    renderSaved();
    toast('Saved.');
  }

  async function loadSaved(entry) {
    state.icon = entry.icon; state.material = entry.material; state.laser = entry.laser;
    if (entry.picture) {
      const img = await loadImage(entry.picture);
      assets.picture = img;
      state.picture = { src: entry.picture, cx: img.naturalWidth / 2, cy: img.naturalHeight / 2, d: img.naturalWidth, rot: 0 };
      ui.zoom.value = zoomToSlider(zoomOf(state.picture));
    }
    if (entry.texture) {
      state.texture = entry.texture;
      assets.texture = await loadImage(entry.texture);
      game.patterns.forEach((tex, key) => { if (key.startsWith('texture:')) game.patterns.delete(key); });
    }
    changed();
  }

  function renderSaved() {
    const list = read(SAVED, []);
    ui.saved.replaceChildren();
    if (!list.length) {
      ui.saved.append(make('div', { className: 'sbx-empty', textContent: 'Nothing saved yet.' }));
      return;
    }
    list.forEach((entry, i) => {
      const c = canvasOf(64, 32);
      const pick = make('div', { className: 'sbx-pick', title: 'Load this badge' }, [c, make('div', { textContent: materialById(entry.material).name })]);
      const del = make('span', { className: 'sbx-del', textContent: '×', title: 'Remove' });
      del.onclick = e => {
        e.stopPropagation();
        const now = read(SAVED, []); now.splice(i, 1); write(SAVED, now); renderSaved();
      };
      pick.append(del);
      pick.onclick = () => loadSaved(entry);
      ui.saved.append(pick);
      Promise.all([entry.picture && loadImage(entry.picture), entry.texture && loadImage(entry.texture)]).then(([pic, tex]) => {
        const keep = { picture: assets.picture, texture: assets.texture, state: state.picture, cut: cutCache };
        if (pic) { assets.picture = pic; state.picture = { src: entry.picture, cx: pic.naturalWidth / 2, cy: pic.naturalHeight / 2, d: pic.naturalWidth, rot: 0 }; cutCache = { key: '', canvas: null }; }
        if (tex) assets.texture = tex;
        drawBadge(c, 32, entry);
        assets.picture = keep.picture; assets.texture = keep.texture; state.picture = keep.state; cutCache = keep.cut;
      }).catch(() => {});
    });
  }

  let toastTimer;
  function toast(text) {
    if (!ui.toastEl) return;
    ui.toastEl.textContent = text;
    ui.toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => ui.toastEl.classList.remove('show'), 2600);
  }

  let queued = false, full = false;
  function refresh() {
    full = true;
    schedule();
  }
  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; const quick = !full; full = false; render(quick); });
  }
  function changed(quick) {
    if (!quick) { save(); full = true; }
    schedule();
  }

  function paintShip() {
    if (!ui.ship) return;
    const pic = shipPicture(200), g = ui.ship.getContext('2d');
    g.clearRect(0, 0, 200, 200);
    if (pic) g.drawImage(pic, 0, 0, 200, 200);
    ui.shipName.textContent = game.names[state.ship] || 'Ship ' + state.ship;
  }
  let shipTimer;
  const drawShip = () => { clearTimeout(shipTimer); shipTimer = setTimeout(paintShip, 60); };

  let ticking = false, lastFrame = 0, lastLive = 0, lastShip = 0;
  function animate() {
    if (ticking) return;
    ticking = true;
    const frame = now => {
      const moving = materialById(state.material).anim;
      const makerOpen = root && root.style.display === 'block';
      const section = $('.sbx-game');
      const sectionShown = !!section && section.offsetParent !== null;
      const live = state.live && moving && mine.length > 0;
      const hulls = hullMotion.length > 0;
      if (!makerOpen && !(sectionShown && moving) && !live && !hulls) { ticking = false; return; }
      requestAnimationFrame(frame);
      if (now - lastFrame < 33) return;
      lastFrame = now;
      clock = now / 1000;
      if (makerOpen) {
        if (moving) {
          drawBadge(ui.big, 160);
          drawBadge(ui.nameBadge, 30);
          for (const pick of ui.lasers.children) drawBadge(pick._canvas, 32, { icon: state.icon, material: state.material, laser: +pick.dataset.id });
        }
        for (const pick of ui.animPicks) drawBadge(pick._canvas, 32, { icon: state.icon, material: pick.dataset.id, laser: state.laser });
      }
      if (sectionShown && moving) drawBadge(section._badge, 112);
      if (live && now - lastLive > 40) { lastLive = now; redrawMine(); }
      if (hulls) moveHulls();
      if (HULL_MOTION[state.material] && now - lastShip > 150) {
        lastShip = now;
        if (makerOpen) paintShip();
        if (sectionShown) renderSectionShip(section);
      }
    };
    requestAnimationFrame(frame);
  }

  function render(quick) {
    clock = performance.now() / 1000;
    if (root && root.style.display === 'block') {
      drawBadge(ui.big, 160);
      drawBadge(ui.nameBadge, 30);
      drawCrop();
      const m = materialById(state.material);
      ui.caption.textContent = [m.name, iconName(state.icon), LASER_NAMES[state.laser]].join(' · ');
      ui.name.textContent = ($('#player input')?.value || '').trim().toUpperCase() || 'COMMANDER';

      if (!quick) {
        drawShip();
        for (const pick of ui.icons.querySelectorAll('.sbx-pick:not(.sbx-add):not(.sbx-upl)')) {
          pick.classList.toggle('sel', pick.dataset.id === state.icon);
          drawIconOnly(pick._canvas, 68, pick.dataset.id);
        }
        for (const pick of ui.materials.querySelectorAll('.sbx-pick:not(.sbx-add):not(.sbx-upl)')) {
          pick.classList.toggle('sel', pick.dataset.id === state.material);
          drawBadge(pick._canvas, 32, { icon: state.icon, material: pick.dataset.id, laser: state.laser });
        }
        for (const pick of ui.lasers.children) {
          pick.classList.toggle('sel', +pick.dataset.id === state.laser);
          drawBadge(pick._canvas, 32, { icon: state.icon, material: state.material, laser: +pick.dataset.id });
        }
        renderLibrary();
      }
    }
    if (!quick) renderSection();
    animate();
  }

  async function restoreAssets() {
    try { if (state.picture) assets.picture = await loadImage(state.picture.src); } catch (e) { state.picture = null; }
    try { if (state.texture) assets.texture = await loadImage(state.texture); } catch (e) { state.texture = null; }
    if (state.icon === 'custom' && !state.picture) state.icon = 'star';
    if (state.material === 'texture' && !state.texture) state.material = 'gold';
    if (state.picture && !state.picture.key) {
      const p = state.picture, entry = keepUpload('pictures', { key: newKey(), src: p.src, crop: { cx: p.cx, cy: p.cy, d: p.d, rot: p.rot } });
      state.picture.key = entry.key;
      save();
    }
    if (state.texture && !library.textures.some(x => x.src === state.texture)) keepUpload('textures', { key: newKey(), src: state.texture });
  }

  async function open() {
    if (!root) {
      build();
      if (state.picture && assets.picture) ui.zoom.value = zoomToSlider(zoomOf(state.picture));
      await document.fonts?.load('20px SBGlyphs').catch(() => {});
      renderSaved();
    }
    root.style.display = 'block';
    render();
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('open')));
  }

  function close() {
    if (!root) return;
    root.classList.remove('open');
    setTimeout(() => { if (!root.classList.contains('open')) root.style.display = 'none'; }, 600);
    renderSection();
  }

  function injectSection() {
    const body = $('.modal .modalbody');
    if (!body || !$('.customtable', body) || $('.sbx-game', body)) return;
    const badge = canvasOf(224, 112), ship = canvasOf(192, 192);
    const sw = make('span', { className: 'sbx-switch sbx-live-switch' });
    const section = make('div', { className: 'sbx-game' }, [
      make('h3', { className: 'customizeship', textContent: 'Custom ECP' }),
      make('table', { className: 'customtable noselect' }, [
        make('tbody', {}, [
          make('tr', {}, [
            make('td', { className: 'sbx-cell frozenbg' }, [badge]),
            make('td', { className: 'sbx-mid' }, [
              make('div', { className: 'sbx-livebox', style: 'cursor:pointer', onclick: () => setLive(!state.live) }, [sw, make('span', { textContent: 'Show in game' })]),
              make('button', { type: 'button', className: 'donate-btn', textContent: 'Open ECP Maker', onclick: open }),
              make('div', { className: 'sbx-hint', textContent: 'Your own badge, material and laser. Only you see it; other players see your normal ECP.' }),
            ]),
            make('td', { className: 'sbx-cell frozenbg' }, [ship]),
          ]),
        ]),
      ]),
    ]);
    section._badge = badge; section._ship = ship;
    const heads = body.querySelectorAll('h3.customizeship');
    const download = heads[heads.length - 1];
    if (download && download.compareDocumentPosition($('.customtable', body)) & Node.DOCUMENT_POSITION_PRECEDING) download.before(section);
    else $('.customtable', body).after(section);
    syncLive();
    renderSection();
  }

  function renderSection() {
    const section = $('.sbx-game');
    if (!section) return;
    drawBadge(section._badge, 112);
    renderSectionShip(section);
    animate();
  }

  function renderSectionShip(section) {
    const pic = shipPicture(192, { ...state, ship: 101, hue: parseInt(localStorage.getItem('shipColor'), 10) || 0 });
    const g = section._ship.getContext('2d');
    g.clearRect(0, 0, 192, 192);
    if (pic) g.drawImage(pic, 0, 0, 192, 192);
  }

  function addButton() {
    const bar = $('.social');
    if (!bar || $('.sbx-ecp-open', bar)) return;
    const btn = make('i', { className: 'sbg sbx-ecp-open', title: 'ECP Maker' });
    const logo = $('#donate .ecplogo img');
    if (logo?.src) btn.append(make('img', { src: logo.src, alt: '' }));
    else btn.append(drawBadge(canvasOf(1, 1), 24, { icon: 'star', material: 'gold', laser: 0 }));
    btn.addEventListener('click', e => {
      e.stopPropagation();
      e.preventDefault();
      open();
    });
    const twitter = $('.sbg-twitter', bar);
    if (twitter) twitter.after(' ', btn); else bar.append(btn);
  }

  document.head.append(make('style', { textContent: css }));
  hookGame();
  restoreAssets();
  addButton();
  new MutationObserver(() => { addButton(); injectSection(); }).observe(document.body, { childList: true, subtree: true });
})();
