    tsb_lightcrystal: (m, t) => motionGlow(m, hsvHex(t * 40 / 360, 0.6, 1)),
    tsb_darkcrystal: (m, t) => motionGlow(m, hsvHex(0, 1, 0.45 + 0.4 * Math.max(0, Math.sin(t * 2.2)))),
    tsb_phantom: (m, t) => motionGlow(m, hsvHex(0, 0, 0.2 + 0.6 * (0.5 + 0.5 * Math.sin(t * 1.5)))),
    tsb_borderlands: (m, t) => motionGlow(m, mixHex(0x202020, 0xFFFFFF, 0.5 - 0.5 * Math.cos(t * 1.2))),
  };
  const hullMotion = [];
  function moveHulls() {
    for (let i = hullMotion.length - 1; i >= 0; i--) {
      const item = hullMotion[i], m = item.ref.deref();
      if (!m) { hullMotion.splice(i, 1); continue; }
      item.motion(m, clock, item.hue);
