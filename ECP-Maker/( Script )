  const HULLS = {
    tsb_magnesium: h => ({ color: 0xCCCCCC, specular: 0xDDDDDD, shininess: 5, emissive: hsvHex(h, 0.75, 1), emissiveMap: 'carbon', plain: true }),
    tsb_contrast: h => ({ color: hsvHex(h, 0.85, 1), specular: 0x606060, shininess: 0, emissive: hsvHex(h, 0.85, 1), plain: true }),
    tsb_gelatin: h => ({ color: hsvHex(h, 1, 0.2), specular: 0xFFFFFF, shininess: 100, bumpScale: 0, emissive: hsvHex(h, 0.5, 1), emissiveMap: 'carbon', plain: true }),
    tsb_borderlands: h => ({ specular: 0x999999, shininess: 0, bumpScale: 100, emissive: hsvHex(h, 1, 0.5), emissiveMap: 'carbon', plain: true }),
    tsb_skeleton: h => ({ specular: 0xCCCCCC, shininess: 5, bumpScale: -10, emissive: hsvHex(h, 1, 0.5), wireframe: true, plain: true }),
    tsb_noir: h => ({ color: 0x000000, specular: hsvHex(h, 1, 0.8), shininess: 10, bumpScale: 2, emissive: 0xFFFFFF, plain: true }),
    hologram: h => ({ specular: 0xFFFFFF, shininess: 0, bumpScale: 2, emissive: hsvHex(h, 0.75, 0.75), emissiveMap: 'none', side: 'double', plain: true }),
    tsb_fennec: h => ({ color: 0x080808, specular: hsvHex(h, 1, 0.7), shininess: 100, bumpScale: 2, emissive: hsvHex(h, 0.7, 0.8), emissiveMap: 'carbon', side: 'double', plain: true }),
    tsb_ashen: h => ({ color: hsvHex(h, 0.5, 0.05), specular: hsvHex(h, 1, 1), shininess: 100, emissive: hsvHex(h + 0.5, 1, 0.1), emissiveMap: 'none', plain: true }),
    tsb_daybreak: h => ({ color: hsvHex(h, 0.7, 0.7), specular: hsvHex(h + 0.66, 1, 1), shininess: 100, emissive: hsvHex(h, 1, 1), plain: true }),
    tsb_nightfall: h => ({ color: hsvHex(h, 1, 0.4), specular: hsvHex(h + 0.33, 1, 1), shininess: 100, emissive: hsvHex(h, 1, 1), plain: true }),
    tsb_darkcrystal: h => ({ mirror: true, metalness: 1, roughness: 0.1, emissive: hsvHex(h, 1, 1) }),
    tsb_lightcrystal: h => ({ mirror: true, metalness: 0, roughness: 1, emissive: hsvHex(h, 1, 1) }),
    tsb_valor: h => ({ mirror: true, metalness: 1, roughness: 0.1, emissive: hsvHex(h, 1, 1) }),
    tsb_phantom: h => ({ mirror: true, metalness: 1, roughness: 0.1, emissive: hsvHex(h, 1, 1), opacity: 0.5 }),
    void: h => ({ mirror: true, metalness: 1, roughness: 0.1, emissive: hsvHex(h, 1, 1) }),
    tsb_iris: h => ({ mirror: true, map: true, bumpScale: 0.5, metalness: 1, roughness: 0.1, color: 0xFFFFFF, emissive: hsvHex(h, 1, 1), emissiveMap: 'carbon', mirrorOf: 'tsb_valor' }),
    tsb_urahara: h => ({ color: 0xABE494, specular: 0x40C0FF, shininess: 30, emissive: hsvHex(h, 0.5, 1) }),
    tsb_sheen: h => ({ color: 0x000000, specular: 0xFFFFFF, shininess: 100, bumpScale: 0.8, emissive: hsvHex(h, 0.75, 1), plain: true }),
    tsb_lustre: h => ({ color: 0x000000, specular: 0xFFFFFF, shininess: 100, bumpScale: 1, emissive: hsvHex(h, 0.75, 1), emissiveMap: 'none', plain: true }),
    tsb_light: () => ({ color: 0xFFFFFF, specular: 0xFFFFFF, shininess: 100, emissive: 0xFFFFFF, emissiveMap: 'none', plain: true }),
    neon: h => ({ color: hsvHex(h, 1, 1), specular: hsvHex(h, 1, 1), shininess: 100, emissive: hsvHex(h, 1, 1), emissiveMap: 'none', wireframe: true, plain: true }),
    tsb_invert: h => ({ color: 0xA0B0C0, specular: 0x805F50, shininess: 30, emissive: hsvHex(h, 0.5, 1), side: 'back' }),
    tsb_halo: h => ({ color: 0xA0B0C0, specular: 0x805F50, shininess: 30, emissive: hsvHex(h, 0.5, 1), side: 'back' }),
    ...Object.fromEntries(['rgbcycle', 'rainbowflow', 'rainbowpulse', 'rainbowstripes', 'kaleidoscope', 'disco', 'pulse', 'heartbeat',
      'breathered', 'breatheblue', 'breathegreen', 'breathepurple', 'breathegold', 'breathecyan', 'police', 'storm']
      .map(id => [id, { color: 0x1A1A1A, specular: 0xFFFFFF, shininess: 80, emissive: 0, emissiveMap: 'none', plain: true }])),
    fire: { color: 0x3A0800, specular: 0xFFB040, shininess: 20, emissive: 0xFF5000, emissiveMap: 'none' },
    electric: { color: 0x061040, specular: 0xC0E8FF, shininess: 100, emissive: 0x3070FF, emissiveMap: 'none' },
    plasmaflow: { color: 0x200840, specular: 0xFF80FF, shininess: 80, emissive: 0xA030FF, emissiveMap: 'none' },
    matrix: { color: 0x001000, specular: 0x40FF60, shininess: 10, emissive: 0x20FF50, emissiveMap: 'none', wireframe: true },
    radar: { color: 0x001A08, specular: 0x40FF80, shininess: 10, emissive: 0x18A040, emissiveMap: 'none', wireframe: true },
