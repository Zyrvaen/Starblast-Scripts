// ==UserScript==
// @name         Starblast ECP Maker
// @namespace    zyrvaen-starblast
// @version      1.9.0
// @description  Adds an ECP button next to the info / settings / social buttons in the Starblast menu and a Custom ECP section to the Elite Commander window. Make your own badge (upload a picture, see how it is cut, pick from many materials and lasers), see it on your ship, and show it in the game on your own screen.
// @author       Zyrvaen
// @match        https://starblast.io/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(() => {
  'use strict';

  const TAU = Math.PI * 2, RAD = Math.PI / 180;
  const STORE = 'sbx-ecp', SAVED = 'sbx-ecp-saved', OFFICIAL = 'sbx-ecp-official', UPLOADS = 'sbx-ecp-uploads', MAX_SAVED = 12, MAX_UPLOADS = 16;

  const $ = (sel, root = document) => root.querySelector(sel);
  const make = (tag, props = {}, kids = []) => {
    const el = Object.assign(document.createElement(tag), props);
    for (const k of kids) el.append(k);
    return el;
  };
  const canvasOf = (w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
  const read = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key)) ?? fallback; } catch (e) { return fallback; } };
  const write = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch (e) { return false; } };
  const toData = c => { const d = c.toDataURL('image/webp', 0.9); return d.startsWith('data:image/webp') ? d : c.toDataURL('image/png'); };

  const imageCache = new Map();
  const loadImage = src => {
    if (!imageCache.has(src)) {
      imageCache.set(src, new Promise((resolve, reject) => {
        const img = new Image();
        if (/^https?:/.test(src) && new URL(src).origin !== location.origin) img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = src;
      }));
    }
    return imageCache.get(src);
  };

  const seeded = seed => () => {
    seed = (seed + 0x6D2B79F5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  const hslHex = (hue, s, l) => {
    const k = n => (n + hue / 30) % 12, a = s * Math.min(l, 1 - l);
    const f = n => Math.round(255 * (l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1))));
    return (f(0) << 16) | (f(8) << 8) | f(4);
  };
  const linear = (ctx, h) => ctx.createLinearGradient(0, 0, 0, h);
  const stops = list => (ctx, w, h) => {
    const g = linear(ctx, h);
    for (const [at, color] of list) g.addColorStop(at, color);
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
  };
  const split = (top, mid, low, bottom) => stops([[0, top], [0.5, mid], [0.5, low], [1, bottom]]);
  const gem = (hue, sat) => split(`hsl(${hue},${sat}%,42%)`, `hsl(${hue},${sat}%,80%)`, `hsl(${hue},${sat}%,20%)`, `hsl(${hue},${sat}%,48%)`);
  const sheen = (ctx, w, h, strength = 1) => {
    const g = linear(ctx, h);
    g.addColorStop(0, `rgba(255,255,255,${0.05 * strength})`);
    g.addColorStop(0.5, `rgba(255,255,255,${0.4 * strength})`);
    g.addColorStop(0.5, `rgba(0,0,0,${0.35 * strength})`);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
  };

  let clock = 0;

  function carbon(ctx, w, h) {
    const n = Math.max(2, Math.min(10, Math.round(h / 10)));
    const a = linear(ctx, h), b = linear(ctx, h);
    for (let i = 0; i <= n - 1; i++) { a.addColorStop(i / n, '#000'); a.addColorStop((i + 1) / n, '#888'); }
    b.addColorStop(0, '#333'); b.addColorStop(0.1, '#888');
    for (let i = 0; i <= n - 1; i++) { b.addColorStop((i + 0.5) / n, '#000'); b.addColorStop(Math.min(1, (i + 1.5) / n), '#888'); }
    for (let i = 0; i <= 4 * n - 1; i++) { ctx.fillStyle = i % 2 ? b : a; ctx.fillRect(i * w / (4 * n), 0, w / (4 * n) + 0.5, h); }
    const shade = linear(ctx, h);
    shade.addColorStop(0.3, 'rgba(0,0,0,.5)'); shade.addColorStop(0.5, 'rgba(0,0,0,0)'); shade.addColorStop(0.7, 'rgba(0,0,0,.5)');
    ctx.fillStyle = shade; ctx.fillRect(0, 0, w, h);
  }

  const goldPaint = split('hsl(40,100%,50%)', 'hsl(40,100%,80%)', 'hsl(20,100%,30%)', 'hsl(40,100%,50%)');
  const chromePaint = stops([[0, '#FFF'], [0.45, '#9AB'], [0.5, '#FFF'], [0.52, '#223'], [0.75, '#678'], [1, '#EEF']]);
  const tinted = (paint, color) => (ctx, w, h) => { paint(ctx, w, h); ctx.fillStyle = color; ctx.fillRect(0, 0, w, h); };

  const striped = (a, b, n, angle) => (ctx, w, h) => {
    const size = Math.hypot(w, h), step = size / n;
    ctx.save(); ctx.translate(w / 2, h / 2); ctx.rotate(angle * RAD);
    for (let i = -n; i <= n; i++) { ctx.fillStyle = Math.abs(i) % 2 ? a : b; ctx.fillRect(i * step, -size, step + 0.5, 2 * size); }
    ctx.restore();
    sheen(ctx, w, h, 0.6);
  };

  const blobs = (base, colors, count, seed, size = 1) => (ctx, w, h) => {
    if (typeof base === 'function') base(ctx, w, h); else { ctx.fillStyle = base; ctx.fillRect(0, 0, w, h); }
    const rnd = seeded(seed);
    for (let i = 0; i < count; i++) {
      ctx.fillStyle = colors[i % colors.length];
      ctx.beginPath();
      ctx.ellipse(rnd() * w, rnd() * h, (0.06 + rnd() * 0.14) * h * size, (0.04 + rnd() * 0.09) * h * size, rnd() * Math.PI, 0, TAU);
      ctx.fill();
    }
    sheen(ctx, w, h, 0.5);
  };

  const squares = (colors, cells, seed) => (ctx, w, h) => {
    const s = h / cells, rnd = seeded(seed);
    for (let y = 0; y < cells; y++) for (let x = 0; x < 2 * cells; x++) {
      ctx.fillStyle = colors[Math.floor(rnd() * colors.length)];
      ctx.fillRect(x * s, y * s, s + 0.5, s + 0.5);
    }
    sheen(ctx, w, h, 0.5);
  };

  const hexes = (top, bottom, line, bg) => (ctx, w, h) => {
    ctx.fillStyle = bg; ctx.fillRect(0, 0, w, h);
    const r = h / 9, dx = r * Math.sqrt(3), dy = r * 1.5;
    ctx.lineWidth = Math.max(1, r / 4);
    for (let row = -1; row * dy < h + r; row++) {
      for (let col = -1; col * dx < w + dx; col++) {
        const cx = col * dx + (row % 2 ? dx / 2 : 0), cy = row * dy;
        ctx.beginPath();
        for (let k = 0; k < 6; k++) ctx.lineTo(cx + r * Math.cos((60 * k + 30) * RAD), cy + r * Math.sin((60 * k + 30) * RAD));
        ctx.closePath();
        const g = ctx.createLinearGradient(cx, cy - r, cx, cy + r);
        g.addColorStop(0, top); g.addColorStop(1, bottom);
        ctx.fillStyle = g; ctx.fill();
        ctx.strokeStyle = line; ctx.stroke();
      }
    }
    sheen(ctx, w, h, 0.6);
  };

  const marble = (base, vein, seed) => (ctx, w, h) => {
    stops([[0, base[0]], [1, base[1]]])(ctx, w, h);
    const rnd = seeded(seed);
    ctx.strokeStyle = vein;
    for (let i = 0; i < 8; i++) {
      ctx.globalAlpha = 0.25 + rnd() * 0.5;
      ctx.lineWidth = (0.006 + rnd() * 0.02) * h;
      ctx.beginPath(); ctx.moveTo(rnd() * w, -0.1 * h);
      ctx.bezierCurveTo(rnd() * w, rnd() * h, rnd() * w, rnd() * h, rnd() * w, 1.1 * h);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
    sheen(ctx, w, h, 0.4);
  };

  const scales = (dark, edge, light) => (ctx, w, h) => {
    ctx.fillStyle = dark; ctx.fillRect(0, 0, w, h);
    const r = h / 7;
    ctx.lineWidth = Math.max(1, r / 8); ctx.strokeStyle = edge;
    for (let row = -1; row * r * 0.7 < h + r; row++) {
      for (let col = -1; col * r * 1.4 < w + r; col++) {
        const cx = col * r * 1.4 + (row % 2 ? r * 0.7 : 0), cy = row * r * 0.7;
        const g = ctx.createLinearGradient(cx, cy, cx, cy + r);
        g.addColorStop(0, light); g.addColorStop(1, dark);
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(cx, cy, r * 0.75, 0, Math.PI); ctx.closePath(); ctx.fill(); ctx.stroke();
      }
    }
    sheen(ctx, w, h, 0.5);
  };

  function rainbow(ctx, w, h) {
    const g = ctx.createLinearGradient(0, 0, w, 0);
    for (let i = 0; i <= 6; i++) g.addColorStop(i / 6, `hsl(${i * 60},90%,55%)`);
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    sheen(ctx, w, h);
  }

  function plasma(ctx, w, h) {
    ctx.fillStyle = '#16052b'; ctx.fillRect(0, 0, w, h);
    for (const [x, color] of [[0.15, 'rgba(255,60,200,.9)'], [0.85, 'rgba(60,200,255,.9)'], [0.5, 'rgba(160,90,255,.6)']]) {
      const g = ctx.createRadialGradient(x * w, h / 2, 0, x * w, h / 2, 0.55 * h);
      g.addColorStop(0, color); g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    }
    sheen(ctx, w, h, 0.6);
  }

  function lavaBlobs(ctx, w, h, moving) {
    ctx.fillStyle = '#1a0402'; ctx.fillRect(0, 0, w, h);
    const rnd = seeded(7);
    for (let i = 0; i < 26; i++) {
      const x = rnd() * w, start = rnd(), speed = 0.05 + rnd() * 0.12, r = (0.08 + rnd() * 0.18) * h;
      const y = moving ? (((start - clock * speed) % 1.4) + 1.4) % 1.4 * h - 0.2 * h : start * h;
      const g = ctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, 'rgba(255,200,60,.95)'); g.addColorStop(0.4, 'rgba(255,80,10,.7)'); g.addColorStop(1, 'rgba(120,10,0,0)');
      ctx.fillStyle = g; ctx.fillRect(x - r, y - r, 2 * r, 2 * r);
    }
    sheen(ctx, w, h, 0.5);
  }

  function galaxy(ctx, w, h) {
    stops([[0, '#0a0b24'], [1, '#1d0f3d']])(ctx, w, h);
    const rnd = seeded(3);
    for (const [x, y, color] of [[0.25, 0.4, 'rgba(90,60,200,.55)'], [0.7, 0.65, 'rgba(200,60,160,.45)'], [0.5, 0.2, 'rgba(60,160,220,.35)']]) {
      const g = ctx.createRadialGradient(x * w, y * h, 0, x * w, y * h, 0.5 * h);
      g.addColorStop(0, color); g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    }
    ctx.fillStyle = '#fff';
    for (let i = 0; i < 70; i++) {
      const s = Math.max(0.6, (rnd() * rnd()) * 0.035 * h);
      ctx.globalAlpha = 0.4 + rnd() * 0.6;
      ctx.fillRect(rnd() * w, rnd() * h, s, s);
    }
    ctx.globalAlpha = 1;
    sheen(ctx, w, h, 0.4);
  }

  function damascus(ctx, w, h) {
    ctx.fillStyle = '#5a5f66'; ctx.fillRect(0, 0, w, h);
    const lines = 16;
    ctx.lineWidth = h / lines / 2.2;
    for (let i = -2; i < lines + 2; i++) {
      ctx.strokeStyle = i % 2 ? 'rgba(20,22,26,.75)' : 'rgba(210,215,222,.7)';
      ctx.beginPath();
      for (let x = 0; x <= w; x += w / 60) {
        const y = (i / lines) * h + Math.sin(x / w * 9 + i * 0.7) * h * 0.05 + Math.sin(x / w * 23) * h * 0.015;
        x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
    }
    sheen(ctx, w, h, 0.7);
  }

  function wood(ctx, w, h) {
    stops([[0, '#9a6532'], [0.5, '#7a4a22'], [1, '#5e3818']])(ctx, w, h);
    ctx.strokeStyle = 'rgba(50,25,8,.45)'; ctx.lineWidth = h / 70;
    for (let i = 0; i < 24; i++) {
      ctx.beginPath();
      for (let x = 0; x <= w; x += w / 50) {
        const y = i / 24 * h + Math.sin(x / w * 6 + i) * h * 0.03 + Math.sin(x / w * 17 + i * 2) * h * 0.01;
        x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
    }
    sheen(ctx, w, h, 0.4);
  }

  function brushed(ctx, w, h) {
    stops([[0, '#d3d8de'], [0.5, '#9aa1a9'], [1, '#6f767e']])(ctx, w, h);
    const rnd = seeded(29);
    for (let i = 0; i < 140; i++) {
      ctx.fillStyle = rnd() < 0.5 ? `rgba(255,255,255,${0.04 + rnd() * 0.12})` : `rgba(0,0,0,${0.04 + rnd() * 0.1})`;
      ctx.fillRect(0, rnd() * h, w, 0.4 + rnd() * 1.2);
    }
    sheen(ctx, w, h, 0.7);
  }

  function hammered(ctx, w, h) {
    split('#5c6670', '#c8d0d8', '#3a4148', '#7a848e')(ctx, w, h);
    const rnd = seeded(31);
    for (let i = 0; i < 80; i++) {
      const x = rnd() * w, y = rnd() * h, r = (0.03 + rnd() * 0.04) * h;
      const g = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, 0, x, y, r);
      g.addColorStop(0, 'rgba(255,255,255,.35)'); g.addColorStop(0.6, 'rgba(0,0,0,.12)'); g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g; ctx.fillRect(x - r, y - r, 2 * r, 2 * r);
    }
  }

  const copperPaint = split('hsl(22,75%,45%)', 'hsl(28,85%,75%)', 'hsl(15,70%,22%)', 'hsl(22,70%,45%)');
  const patina = blobs(copperPaint, ['rgba(64,190,160,.75)', 'rgba(40,150,130,.6)', 'rgba(120,220,190,.5)'], 45, 37, 0.7);
  const rust = blobs('#6b3518', ['#a0521d', '#3d1f0e', '#c06a2a', '#57301a'], 70, 23, 0.5);

  function checker(ctx, w, h) {
    const s = h / 6;
    for (let y = 0; y < 6; y++) for (let x = 0; x < 12; x++) { ctx.fillStyle = (x + y) % 2 ? '#EEE' : '#111'; ctx.fillRect(x * s, y * s, s + 0.5, s + 0.5); }
    sheen(ctx, w, h, 0.6);
  }

  function zebra(ctx, w, h) {
    ctx.fillStyle = '#f2f2f2'; ctx.fillRect(0, 0, w, h);
    const rnd = seeded(41);
    ctx.fillStyle = '#111';
    for (let i = 0; i < 16; i++) {
      const x0 = (i + rnd() * 0.4) / 16 * w, width = (0.25 + rnd() * 0.2) * w / 16, wave = rnd() * TAU;
      ctx.beginPath();
      for (let y = 0; y <= h; y += h / 20) ctx.lineTo(x0 + Math.sin(y / h * 5 + wave) * w * 0.02, y);
      for (let y = h; y >= 0; y -= h / 20) ctx.lineTo(x0 + width + Math.sin(y / h * 5 + wave + 0.6) * w * 0.02, y);
      ctx.fill();
    }
    sheen(ctx, w, h, 0.5);
  }

  function tiger(ctx, w, h) {
    stops([[0, '#f39a2c'], [0.5, '#e07a18'], [1, '#b65a0c']])(ctx, w, h);
    const rnd = seeded(43);
    ctx.fillStyle = '#1a1008';
    for (let i = 0; i < 18; i++) {
      const x = rnd() * w, width = (0.02 + rnd() * 0.03) * w, len = (0.25 + rnd() * 0.3) * h;
      const y0 = i % 2 ? h : 0, dir = i % 2 ? -1 : 1;
      ctx.beginPath(); ctx.moveTo(x - width, y0);
      ctx.quadraticCurveTo(x + width * 2, y0 + dir * len * 0.5, x + width * 0.5, y0 + dir * len);
      ctx.quadraticCurveTo(x + width * 1.2, y0 + dir * len * 0.4, x + width, y0);
      ctx.fill();
    }
    sheen(ctx, w, h, 0.5);
  }

  function leopard(ctx, w, h) {
    ctx.fillStyle = '#d9a95b'; ctx.fillRect(0, 0, w, h);
    const rnd = seeded(47);
    for (let i = 0; i < 50; i++) {
      const x = rnd() * w, y = rnd() * h, r = (0.04 + rnd() * 0.04) * h, a = rnd() * TAU;
      ctx.fillStyle = '#9a6526'; ctx.beginPath(); ctx.arc(x, y, r * 0.7, 0, TAU); ctx.fill();
      ctx.strokeStyle = '#2a1a0a'; ctx.lineWidth = r * 0.4;
      ctx.beginPath(); ctx.arc(x, y, r, a, a + 4.3); ctx.stroke();
    }
    sheen(ctx, w, h, 0.4);
  }

  function circuit(ctx, w, h) {
    stops([[0, '#0f4a2a'], [1, '#06281a']])(ctx, w, h);
    const rnd = seeded(53), g = h / 10;
    ctx.strokeStyle = 'rgba(80,240,150,.85)'; ctx.fillStyle = 'rgba(160,255,200,.95)'; ctx.lineWidth = Math.max(1, h / 70);
    for (let i = 0; i < 28; i++) {
      let x = Math.round(rnd() * 20) * g, y = Math.round(rnd() * 10) * g;
      ctx.beginPath(); ctx.moveTo(x, y);
      for (let k = 0; k < 3; k++) {
        const d = g * (1 + Math.floor(rnd() * 3)) * (rnd() < 0.5 ? -1 : 1);
        if (rnd() < 0.5) x += d; else y += d;
        ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.beginPath(); ctx.arc(x, y, g * 0.22, 0, TAU); ctx.fill();
    }
    sheen(ctx, w, h, 0.4);
  }

  function racing(ctx, w, h) {
    split('hsl(355,85%,45%)', 'hsl(355,90%,65%)', 'hsl(355,80%,28%)', 'hsl(355,85%,45%)')(ctx, w, h);
    ctx.fillStyle = 'rgba(255,255,255,.92)';
    ctx.fillRect(0, 0.3 * h, w, 0.08 * h); ctx.fillRect(0, 0.62 * h, w, 0.08 * h);
  }

  function neongrid(ctx, w, h) {
    stops([[0, '#1a0033'], [0.55, '#4a0060'], [1, '#12001f']])(ctx, w, h);
    const horizon = 0.55 * h;
    const sun = ctx.createLinearGradient(0, horizon - 0.35 * h, 0, horizon);
    sun.addColorStop(0, '#ffd23f'); sun.addColorStop(1, '#ff3d8b');
    ctx.fillStyle = sun; ctx.beginPath(); ctx.arc(w / 2, horizon, 0.32 * h, Math.PI, TAU); ctx.fill();
    ctx.strokeStyle = 'rgba(255,61,242,.85)'; ctx.lineWidth = Math.max(1, h / 80);
    for (let i = 1; i < 8; i++) { const y = horizon + (h - horizon) * Math.pow(i / 7, 1.8); ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }
    for (let i = -10; i <= 10; i++) { ctx.beginPath(); ctx.moveTo(w / 2 + i * w * 0.02, horizon); ctx.lineTo(w / 2 + i * w * 0.12, h); ctx.stroke(); }
    sheen(ctx, w, h, 0.3);
  }

  function waveLines(ctx, w, h, t) {
    ctx.strokeStyle = 'rgba(200,240,255,.35)'; ctx.lineWidth = Math.max(1, h / 60);
    for (let i = 0; i < 7; i++) {
      ctx.beginPath();
      for (let x = 0; x <= w; x += w / 40) {
        const y = (i + 0.5) / 7 * h + Math.sin(x / w * 8 + i * 1.3 + t * 2) * h * 0.03;
        x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
    }
  }
  const oceanBase = stops([[0, '#0b4f7a'], [0.5, '#1c8fc4'], [1, '#062c48']]);
  function ocean(ctx, w, h) { oceanBase(ctx, w, h); waveLines(ctx, w, h, 0); sheen(ctx, w, h, 0.5); }

  function opal(ctx, w, h) {
    split('#e9eef2', '#ffffff', '#cdd6dd', '#e4eaef')(ctx, w, h);
    const g = ctx.createLinearGradient(0, 0, w, h);
    const colors = ['rgba(255,140,200,.4)', 'rgba(140,200,255,.4)', 'rgba(150,255,190,.4)', 'rgba(255,230,140,.4)', 'rgba(200,150,255,.4)'];
    colors.forEach((c, i) => g.addColorStop(i / (colors.length - 1), c));
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    sheen(ctx, w, h, 0.5);
  }

  function pearl(ctx, w, h) {
    split('#efe7e1', '#ffffff', '#d6cbc3', '#ece2da')(ctx, w, h);
    const g = ctx.createRadialGradient(0.3 * w, 0.3 * h, 0, 0.3 * w, 0.3 * h, 0.8 * h);
    g.addColorStop(0, 'rgba(255,200,225,.35)'); g.addColorStop(1, 'rgba(255,200,225,0)');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
  }

  function rainbowFlow(ctx, w, h) {
    const g = ctx.createLinearGradient(0, 0, w, 0);
    for (let i = 0; i <= 6; i++) g.addColorStop(i / 6, `hsl(${(i * 60 + clock * 90) % 360},90%,55%)`);
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    sheen(ctx, w, h);
  }

  const shimmer = base => (ctx, w, h) => {
    base(ctx, w, h);
    const p = ((clock * 0.45) % 1.8 - 0.4) * w;
    const g = ctx.createLinearGradient(p - 0.2 * w, 0, p + 0.1 * w, h);
    g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(0.5, 'rgba(255,255,255,.75)'); g.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
  };

  function diamond(ctx, w, h) {
