  function carbonGlow(ship) {
    if (game.carbonGlow === undefined) {
      try { game.carbonGlow = game.build.buildCarbonMaterial.call(ship).emissiveMap || null; } catch (e) { game.carbonGlow = null; }
    }
    return game.carbonGlow;
  }

  function mirrorWorld(id) {
    const key = 'env:' + id;
    if (game.patterns.has(key)) return game.patterns.get(key);
    const sides = Array.from({ length: 6 }, (_, i) => {
      const c = canvasOf(128, 128), g = c.getContext('2d');
      g.translate(64, 64); g.rotate(i * 0.9); g.translate(-64, -64);
      paintMaterial(g, 128, 128, id);
      return c;
    });
    const tex = new window.THREE.CubeTexture(sides);
    tex.needsUpdate = true;
    game.patterns.set(key, tex);
    return tex;
  }

  function shipMaterial(ship, id) {
    if (OFFICIAL_BUILD[id]) return game.build[OFFICIAL_BUILD[id]].call(ship);
    const hull = HULLS[id] || materialById(id).ship;
    let look = (typeof hull === 'function' ? hull(ship.hue) : hull) || [0xFFFFFF, 0xA0A0A0, 40, true];
    if (Array.isArray(look)) look = { color: look[0], specular: look[1], shininess: look[2], pattern: look[3] };
    const glowMap = look.emissiveMap === 'carbon' ? carbonGlow(ship) : undefined;
    game.build.buildGoldMaterial.call(ship);
    let m = ship.material;
    const THREE = window.THREE;

    if (look.mirror && THREE.MeshStandardMaterial && THREE.CubeTexture) {
      const base = m;
      m = new THREE.MeshStandardMaterial({
        color: look.color ?? 0xFFFFFF,
        emissive: look.emissive ?? 0,
        metalness: look.metalness ?? 1,
        roughness: Math.min(1, look.roughness ?? 0.1),
        envMap: mirrorWorld(look.mirrorOf || id),
      });
      if (look.map) { m.map = base.map; m.bumpMap = base.bumpMap; m.bumpScale = look.bumpScale ?? 1; }
      if (glowMap) m.emissiveMap = glowMap;
      m.specular = new THREE.Color();
      base.dispose();
      ship.material = m;
    } else {
      m.color.setHex(look.color ?? 0xFFFFFF);
      m.specular.setHex(look.specular ?? 0xA0A0A0);
      m.shininess = look.shininess ?? 40;
      if (look.plain) m.specularMap = null;
      if (look.bumpScale != null) m.bumpScale = look.bumpScale;
      if (look.pattern) {
        const tex = hullPattern(id, m.map);
        if (tex) m.map = tex;
      }
      if (look.emissive != null) m.emissive.setHex(look.emissive);
      if (look.emissiveMap === 'none') m.emissiveMap = null;
      else if (glowMap) m.emissiveMap = glowMap;
      if (look.wireframe) m.wireframe = true;
    }
    if (look.opacity != null && look.opacity < 1) { m.transparent = true; m.opacity = look.opacity; }
    if (look.side === 'double') m.side = THREE.DoubleSide;
    if (look.side === 'back') m.side = THREE.BackSide;
    keepGlow(ship, m, look.emissive);
    const motion = HULL_MOTION[id];
    if (motion) {
      motion(m, clock, ship.hue);
      hullMotion.push({ ref: new WeakRef(m), motion, hue: ship.hue });
      if (hullMotion.length > 40) hullMotion.shift();
      animate();
    }
    m.needsUpdate = true;
    return m;
  }

  function keepGlow(ship, m, glow) {
    if (glow == null || !m.emissive) return;
    const set = m.emissive.set.bind(m.emissive);
    const normal = hsvHex(ship.hue, 0.5, 1);
    const close = (a, b) => [16, 8, 0].every(s => Math.abs(((a >> s) & 255) - ((b >> s) & 255)) <= 3);
    m.__sbxGlow = glow;
    m.emissive.set = value => (typeof value === 'number' && close(value, normal)) ? set(m.__sbxGlow) : set(value);
  }

  const mixHex = (a, b, k) => [16, 8, 0].reduce((out, s) => out | (Math.round(((a >> s) & 255) + (((b >> s) & 255) - ((a >> s) & 255)) * k) << s), 0);
  const motionGlow = (m, hex) => { m.__sbxGlow = hex; m.emissive.setHex(hex); };
  const breatheGlow = hue => (m, t) => motionGlow(m, hsvHex(hue / 360, 0.9, 0.35 + 0.35 * Math.sin(t * 2.5)));
  const HULL_MOTION = {
    rgbcycle: (m, t) => motionGlow(m, hsvHex(t / 6, 1, 1)),
    rainbowflow: (m, t) => motionGlow(m, hsvHex(t / 4, 1, 0.9)),
    rainbowpulse: (m, t) => motionGlow(m, hsvHex(t * 80 / 360, 1, 0.55 + 0.3 * Math.sin(t * 4))),
    rainbowstripes: (m, t) => motionGlow(m, hsvHex(t / 5, 1, 0.9)),
    kaleidoscope: (m, t) => motionGlow(m, hsvHex(t * 50 / 360, 0.9, 0.8)),
    disco: (m, t) => motionGlow(m, hsvHex(t * 90 / 360, 0.9, 0.75 + 0.2 * Math.sin(t * 3))),
    pulse: (m, t) => motionGlow(m, hsvHex(0.97, 0.9, 0.35 + 0.35 * Math.sin(t * 5))),
    heartbeat: (m, t) => { const k = t % 1.1; motionGlow(m, hsvHex(0.97, 0.9, 0.15 + 0.8 * (Math.exp(-((k - 0.1) ** 2) / 0.009) + 0.7 * Math.exp(-((k - 0.32) ** 2) / 0.009)))); },
