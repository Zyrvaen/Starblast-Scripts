    g.globalCompositeOperation = 'multiply';
    g.drawImage(pattern, 0, 0);
    g.globalCompositeOperation = 'destination-in';
    g.drawImage(img, 0, 0);
    const tex = new window.THREE.Texture(c);
    for (const k of ['wrapS', 'wrapT', 'minFilter', 'magFilter', 'anisotropy', 'flipY']) if (k in base) tex[k] = base[k];
    tex.needsUpdate = true;
    game.patterns.set(key, tex);
    return tex;
  }

  function shipPicture(size, look = state) {
    if (!game.Ship) return null;
    const finish = OFFICIAL_BUILD[look.material] ? look.material : 'sbx-' + look.material;
    game.naming = look.ship;
